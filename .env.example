# Tranquis — environment variables
# Copy to .env.local for local development

# API — point at local backend during dev
# For device testing use your machine's LAN IP, e.g. http://192.168.1.100:8000
EXPO_PUBLIC_API_URL=http://localhost:8000

# RevenueCat (add real keys before App Store submission)
EXPO_PUBLIC_RC_IOS_KEY=TRANQUIS_IOS_RC_KEY_HERE
EXPO_PUBLIC_RC_ANDROID_KEY=TRANQUIS_ANDROID_RC_KEY_HERE
