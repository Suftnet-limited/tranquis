# Tranquis — environment variables
# Copy to .env.local for local development

# API — point at local backend during dev
# For device testing use your machine's LAN IP, e.g. http://192.168.1.100:8000
EXPO_PUBLIC_API_URL=http://localhost:8000

# RevenueCat (add real keys before App Store submission)
EXPO_PUBLIC_RC_IOS_KEY=TRANQUIS_IOS_RC_KEY_HERE
EXPO_PUBLIC_RC_ANDROID_KEY=TRANQUIS_ANDROID_RC_KEY_HERE

# Web subscription checkout page
EXPO_PUBLIC_WEB_SUBSCRIBE_URL=https://learnify-lfhf.onrender.com/subscribe/tranquis

# RevenueCat / Apple IAP feature flag
# Set to true only when RevenueCat keys are configured and IAP is ready for App Store release.
# When false (the default), the premium screen shows web checkout (Stripe) only.
EXPO_PUBLIC_ENABLE_REVENUECAT=false
