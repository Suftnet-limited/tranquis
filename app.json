{
  "expo": {
    "name": "Tranquis",
    "slug": "tranquis",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D1F1E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.suftnet.tranquis",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Tranquis uses your camera to scan text for translation.",
        "NSMicrophoneUsageDescription": "Tranquis uses your microphone for voice translation.",
        "NSPhotoLibraryUsageDescription": "Tranquis accesses your photo library to translate text in images."
      },
      "appleTeamId": "ZQADUF26X5",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D1F1E"
      },
      "package": "com.suftnet.tranquis",
      "versionCode": 1,
      "edgeToEdgeEnabled": false,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Tranquis uses your photo library to translate text in images.",
          "cameraPermission": "Tranquis uses the camera to scan text for translation."
        }
      ],
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ]
    ],
    "scheme": "tranquis",
    "experiments": {
      "typedRoutes": true
    }
  }
}
